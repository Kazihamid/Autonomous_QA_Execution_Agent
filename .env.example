# ONE settings file for the whole project.
# Copy this file to .env (START_PROJECT.bat does it for you the first time) and fill in the values.
# .env is ignored by Git and holds real passwords: never commit it or share it.
# Put a value in single quotes when it contains $ or #, for example SECRET_PASSWORD_ENV27='pa$$word'.

# ---------------- Platform settings ----------------
PLATFORM_ENV=local
SPRING_PROFILES_ACTIVE=dev
CONTROL_PLANE_PORT=8080
AI_GATEWAY_PORT=8090
WEB_PORT=3000
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_MODE=dev
POSTGRES_DB=automation
POSTGRES_USER=automation
POSTGRES_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5432/automation
MINIO_ROOT_USER=localadmin
MINIO_ROOT_PASSWORD=
VALKEY_IMAGE=valkey/valkey:8-alpine
POSTGRES_IMAGE=postgres:18-alpine
S3_IMAGE=minio/minio:latest
# Set to true to allow environments on private/internal addresses (for example an intranet test site).
PLATFORM_ALLOW_PRIVATE_TARGETS=false
PLATFORM_ALLOWED_TARGET_HOSTS=
OIDC_ISSUER_URI=

# ---------------- Test passwords and test data ----------------
# A scenario stores only a secret NAME (for example SECRET_PASSWORD). When it runs, the runner picks the value
# using the first of these names that exists, most specific first (no restart needed after a change):
#
#   SECRET_PASSWORD_<ENV>_<USER>   one user on one environment
#   SECRET_PASSWORD_<ENV>          every user on one environment
#   SECRET_PASSWORD_<USER>         one user on any environment
#   SECRET_PASSWORD                fallback for everything
#
# <ENV>  = first part of the website address, upper case, other characters become _ :
#          env27.erp.bracits.net -> ENV27,  erpstaging.brac.net -> ERPSTAGING,  er-panel-stg.bracits.net -> ER_PANEL_STG
# <USER> = the user name the scenario logs in with (the "username" test-data value)
#
# Example: erpStaging gives each user a different password; env27 uses one password for everyone.
SECRET_PASSWORD_ERPSTAGING_153872=''
SECRET_PASSWORD_ERPSTAGING_200001=''
SECRET_PASSWORD_ENV27=''
SECRET_PASSWORD=''
